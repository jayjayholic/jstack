{
  "domain": "security",
  "set": "holdout",
  "cases": [
    {
      "id": "stringify-error",
      "rule": "sec.raw-error-log",
      "kind": "slop",
      "note": "serialising the whole error",
      "files": {
        "src/api/hook.ts": "function onFail(error) {\n  logger.error(JSON.stringify(error))\n}\nexport { onFail }\n"
      },
      "expect": [
        {
          "path": "src/api/hook.ts",
          "line": 2
        }
      ]
    },
    {
      "id": "regexp-string-star",
      "rule": "sec.nested-quantifier",
      "kind": "slop",
      "note": "nested star inside a RegExp string",
      "files": {
        "src/api/match.ts": "const RE = new RegExp('^(a+)+$')\nexport { RE }\n"
      },
      "expect": [
        {
          "path": "src/api/match.ts",
          "line": 1
        }
      ]
    },
    {
      "id": "bounded-class",
      "rule": "sec.nested-quantifier",
      "kind": "near-miss",
      "note": "a single quantified class is linear",
      "files": {
        "src/api/match.ts": "const RE = /^[a-z]{1,64}$/\nexport { RE }\n"
      },
      "expect": []
    }
  ]
}
