    },
    {
      "id": "catch-returns-failure",
      "rule": "conc.empty-catch",
      "kind": "near-miss",
      "note": "catch returns a typed failure",
      "files": {
        "src/workers/notify.ts": "async function notify(user) {\n  try { await mailer.send(user) } catch (err) { return { ok: false, error: err.code } }\n  return { ok: true }\n}\nexport { notify }\n"
      },
      "expect": []
    }
  ]
