{
  "domain": "eval-testing",
  "set": "holdout",
  "cases": [
    {
      "id": "pytest-skip",
      "rule": "test.focus-skip",
      "kind": "slop",
      "note": "a skipped Python test",
      "files": {
        "tests/test_sync.py": "import pytest\n@pytest.mark.skip\ndef test_sync():\n    assert sync() == 1\n"
      },
      "expect": [
        {
          "path": "tests/test_sync.py",
          "line": 2
        }
      ]
    },
    {
      "id": "to-be-null",
      "rule": "test.weak-assert",
      "kind": "near-miss",
      "note": "asserting exactly null",
      "files": {
        "src/a.test.ts": "it('x', () => {\n  expect(find()).toBeNull()\n})\n"
      },
      "expect": []
    },
    {
      "id": "script-fixed-loopback",
      "rule": "test.hardcoded-port",
      "kind": "slop",
      "note": "a script hits a fixed loopback port",
      "files": {
        "scripts/smoke.mjs": "const res = await fetch('http://127.0.0.1:8080/health')\nconsole.log(res.status)\n"
      },
      "expect": [
        {
          "path": "scripts/smoke.mjs",
          "line": 1
        }
      ]
    },
    {
      "id": "script-base-url",
      "rule": "test.hardcoded-port",
      "kind": "near-miss",
      "note": "base URL from env",
      "files": {
        "scripts/smoke.mjs": "const res = await fetch(`${process.env.BASE_URL}/health`)\nconsole.log(res.status)\n"
      },
      "expect": []
    }
  ]
}
