{
  "description": "jstack guards: heavy commands only through the lock, no recursive scans over the repo, cleanup of what a subagent left running, and closing the automation browsers it left open. No-ops unless ~/.jstack/guards.json names the project. Plus the pre-flight nudge on the first edit in a git repo (context only, never blocks; off with JSTACK_PREFLIGHT=off or \"preflight\": {\"enabled\": false}). In a Claude Code cloud session only, and only in repos without their own cloud kit: restores the repo's env files from the owner's encrypted store at session start and saves work in progress at each turn end (tools/cloud/cloud-kit.mjs).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.mjs",
              "edit"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Grep|Glob|LSP",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.mjs",
              "pre"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.mjs",
              "post"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.mjs",
              "cleanup"
            ],
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.mjs",
              "cleanup"
            ],
            "timeout": 45
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/cloud/cloud-kit.mjs",
              "hook-stop"
            ],
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/cloud/cloud-kit.mjs",
              "hook-start"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
